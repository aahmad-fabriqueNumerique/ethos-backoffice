# Copy this file to .env and fill in the values OR run ```npm run setup```

# ---------------------------------------------------------------------------
# Firebase client configuration (exposed to the browser via runtimeConfig.public)
# ---------------------------------------------------------------------------
NUXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NUXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ---------------------------------------------------------------------------
# Firebase Admin SDK configuration (server-side only, NOT exposed to the client)
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_admin_client_email_here
# The private key must be enclosed in double quotes and keep its \n newlines
FIREBASE_PRIVATE_KEY="your_private_key_here"

# ---------------------------------------------------------------------------
# OpenAgenda API configuration (server-side only)
# ---------------------------------------------------------------------------
OPENAGENDA_API_KEY=your_openagenda_api_key_here
AGENDA_TRAD_UID=your_agenda_trad_uid_here
LO_CALEN_DIARI_UID=your_lo_calendiari_uid_here

# ---------------------------------------------------------------------------
# Uploads (server-side only)
# ---------------------------------------------------------------------------
# Temporary directory used by /api/upload-songs (optional, defaults to /tmp)
TMP_UPLOADS_DIR=/tmp

# ---------------------------------------------------------------------------
# Google Analytics 4 (server-side only, dashboard statistics)
# ---------------------------------------------------------------------------
# Numeric GA4 property id. The Firebase service account above must have at
# least the "Viewer" role on this property.
ANALYTICS_PROPERTY_ID=123456789
